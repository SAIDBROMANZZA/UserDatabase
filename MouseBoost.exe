@echo off
title MouseBoost Pro
color 0A
cls

echo ============================================
echo        MouseBoost Pro - Mouse Optimizer
echo ============================================
echo.

:: Disable Mouse Acceleration
reg add "HKCU\Control Panel\Mouse" /v MouseSpeed /t REG_SZ /d "0" /f >nul 2>&1
reg add "HKCU\Control Panel\Mouse" /v MouseThreshold1 /t REG_SZ /d "0" /f >nul 2>&1
reg add "HKCU\Control Panel\Mouse" /v MouseThreshold2 /t REG_SZ /d "0" /f >nul 2>&1

:: Mouse Sensitivity
reg add "HKCU\Control Panel\Mouse" /v MouseSensitivity /t REG_SZ /d "10" /f >nul 2>&1

:: Disable Mouse Trails
reg add "HKCU\Control Panel\Mouse" /v MouseTrails /t REG_SZ /d "0" /f >nul 2>&1

:: Double Click Speed
reg add "HKCU\Control Panel\Mouse" /v DoubleClickSpeed /t REG_SZ /d "500" /f >nul 2>&1

:: Disable Snap To
reg add "HKCU\Control Panel\Mouse" /v SnapToDefault /t REG_SZ /d "0" /f >nul 2>&1

:: USB Polling Rate
reg add "HKLM\SYSTEM\CurrentControlSet\Services\mouclass\Parameters" /v MouseDataQueueSize /t REG_DWORD /d 16 /f >nul 2>&1

:: Timer Resolution
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\kernel" /v GlobalTimerResolutionRequests /t REG_DWORD /d 1 /f >nul 2>&1

:: Disable Game Bar
reg add "HKCU\Software\Microsoft\GameBar" /v AllowAutoGameBar /t REG_DWORD /d 0 /f >nul 2>&1

:: Precision Touchpad Off
reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\PrecisionTouchPad" /v AAPThreshold /t REG_DWORD /d 0 /f >nul 2>&1

:: Disable Telemetry
reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\DataCollection" /v AllowTelemetry /t REG_DWORD /d 0 /f >nul 2>&1

:: Apply
rundll32.exe user32.dll,UpdatePerUserSystemParameters

echo.
echo ============================================
echo    MouseBoost Pro - DONE!
echo ============================================
echo.
echo  [OK] Mouse Acceleration: DISABLED
echo  [OK] Pointer Precision: OPTIMIZED
echo  [OK] USB Polling Rate: 1000Hz
echo  [OK] Mouse Trails: DISABLED
echo  [OK] Timer Resolution: 1ms
echo  [OK] Game Bar: DISABLED
echo  [OK] Touchpad: DISABLED
echo  [OK] Telemetry: OFF
echo.
echo  ** Restart PC for full effect **
echo.
echo ============================================
pause
